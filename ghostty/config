font-family = ComicShanns Nerd Font
font-size = 14
font-feature = -calt,-liga,-dlig
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor
minimum-contrast = 1


window-padding-x = 0
window-padding-y = 0
window-padding-balance = false
window-width = 187
window-height = 72
background-opacity = 0.80
background-opacity-cells = true
background-blur = 30
macos-titlebar-style = native

# Follow macOS appearance using the matching custom palettes.
theme = light:/Users/aryansuri/.config/terminal-style/light/ghostty.conf,dark:/Users/aryansuri/.config/terminal-style/dark/ghostty.conf
window-theme = system
